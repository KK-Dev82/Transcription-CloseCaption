# Base Image ใหม่สำหรับ Transcription Service
# ⭐ Image นี้มี dependencies ทั้งหมดติดตั้งไว้แล้ว ไม่ต้อง install ใหม่ทุกครั้งที่ restart POD
#
# Base Image: pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel
# ✅ ใช้ PyTorch Official Image ที่มี PyTorch + CUDA + cuDNN + Build Tools พร้อมแล้ว
# ✅ มี Python 3.10 (ตรวจสอบแล้ว: 2.1.0-cuda11.8-cudnn8-runtime มี Python 3.10.13)
# ⚠️ หมายเหตุ: Tag ที่ระบุ py3.10 ชัดเจน (2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04) ไม่มีใน Docker Hub
#    แต่ devel image มี Python 3.10 อยู่แล้ว (ตรวจสอบจาก runtime image)
#
# Build for linux/amd64 (RunPod)
# ⚠️ สำคัญ: RunPod ใช้ linux/amd64 (x86_64)
#    ถ้า build บน macOS (ARM64) ต้องใช้ --platform=linux/amd64
#    Script จะ auto-detect และใช้ --platform อัตโนมัติ
#
# Build:
#   docker build -f Dockerfile.base-new -t your-registry/transcription-base:latest .
#
# Push:
#   docker push your-registry/transcription-base:latest
#
# ✅ ข้อดี:
# - ไม่ต้องรัน install-dependencies.sh ทุกครั้งที่ restart POD
# - Start services ได้ทันทีหลัง clone repo
# - ลดเวลา startup และความเสี่ยงจาก network issues
# - ใช้ PyTorch Official Image ที่เสถียร
# - มี Build Tools (devel image) + Python 3.10

FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel

# Set environment variables for non-interactive installation (ต้องตั้งก่อน RUN apt-get)
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Bangkok
ENV TZDIR=/usr/share/zoneinfo

# Install system dependencies
# ✅ Devel image มี build tools อยู่แล้ว แต่ติดตั้งเพิ่มเพื่อความแน่ใจ
RUN apt-get update && apt-get install -y \
    # Build tools (devel image มีอยู่แล้วบางส่วน แต่ติดตั้งเพื่อความแน่ใจ)
    build-essential \
    cmake \
    git \
    git-lfs \
    wget \
    curl \
    # Redis (สำหรับ local Redis service ใน Direct mode)
    redis-server \
    # Utilities
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio/Video processing
    ffmpeg \
    # Timezone data (required for pythainlp)
    tzdata \
    # Network tools
    netcat \
    telnet \
    jq \
    # SSH server (สำหรับ RunPod SSH access)
    openssh-server \
    # Audio libraries (required for librosa, soundfile, pydub)
    libmagic1 \
    libsndfile1 \
    libportaudio2 \
    libasound2-dev \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Initialize git-lfs (สำหรับโมเดล/ไฟล์ใหญ่ใน Git)
RUN git lfs install

# Setup SSH server (สำหรับ RunPod SSH access)
# ⚠️ หมายเหตุ: RunPod จะจัดการ SSH port forwarding อัตโนมัติ
#    แต่ต้องมี SSH server ติดตั้งและเปิดพอร์ท 22 ไว้
RUN mkdir -p /var/run/sshd && \
    # ตั้งค่า SSH config พื้นฐาน
    echo 'Port 22' >> /etc/ssh/sshd_config && \
    echo 'ListenAddress 0.0.0.0' >> /etc/ssh/sshd_config && \
    echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config && \
    echo 'PubkeyAuthentication yes' >> /etc/ssh/sshd_config && \
    # สร้าง SSH directory สำหรับ root
    mkdir -p /root/.ssh && \
    chmod 700 /root/.ssh && \
    touch /root/.ssh/authorized_keys && \
    chmod 600 /root/.ssh/authorized_keys

# Base image มี PyTorch 2.1.0+cu118 อยู่แล้ว
# ตรวจสอบ Python และ PyTorch version (optional - for verification)
RUN python3 --version && \
    python3 -c "import torch; print(f'✅ PyTorch: {torch.__version__}'); print(f'✅ CUDA available: {torch.cuda.is_available()}'); print(f'✅ CUDA version: {torch.version.cuda}'); print(f'✅ cuDNN version: {torch.backends.cudnn.version() if torch.backends.cudnn.is_available() else \"N/A\"}')" || true

# Install faster-whisper with compatible versions (CUDA 11.8)
# ⚠️ สำคัญ: ใช้ CTranslate2 4.4.0 เพื่อให้ compatible กับ cuDNN 8 (ไม่ใช่ 4.5.0+ ที่ต้องการ cuDNN 9)
RUN pip3 install --no-cache-dir \
    numpy==1.26.4 \
    "ctranslate2==4.4.0" \
    "faster-whisper==1.0.3"

# Install Core FastAPI dependencies
RUN pip3 install --no-cache-dir \
    fastapi==0.104.1 \
    "uvicorn[standard]==0.24.0" \
    python-multipart==0.0.6 \
    websockets==12.0 \
    pydantic==2.5.0

# Install RabbitMQ and async dependencies
RUN pip3 install --no-cache-dir \
    aiofiles==23.2.1 \
    "aio-pika==9.3.0" \
    pika==1.3.2 \
    aiohttp==3.9.1 \
    requests==2.31.0

# Install Redis client
RUN pip3 install --no-cache-dir \
    "redis[hiredis]==5.0.1"

# Install Whisper dependencies
RUN pip3 install --no-cache-dir \
    openai-whisper==20231117

# Install Audio processing libraries
RUN pip3 install --no-cache-dir \
    librosa==0.10.1 \
    soundfile==0.12.1 \
    pydub==0.25.1

# Install File handling
RUN pip3 install --no-cache-dir \
    python-magic==0.4.27

# Install JSON and data handling
RUN pip3 install --no-cache-dir \
    python-json-logger==2.0.7

# Install Async and concurrency
RUN pip3 install --no-cache-dir \
    asyncio-mqtt==0.16.1

# Install Utilities
RUN pip3 install --no-cache-dir \
    python-dotenv==1.0.0 \
    click==8.1.7 \
    tqdm==4.66.1

# Install Thai NLP
RUN pip3 install --no-cache-dir \
    pythainlp==4.0.2 \
    attacut==1.0.6

# Install Dashboard dependencies
RUN pip3 install --no-cache-dir \
    jinja2==3.1.2 \
    psutil==5.9.6 \
    docker==6.1.3

# Install FFmpeg Python wrapper
RUN pip3 install --no-cache-dir \
    ffmpeg-python==0.2.0

# Install Additional dependencies from requirements.txt
RUN pip3 install --no-cache-dir \
    sqlalchemy==2.0.23 \
    "python-jose[cryptography]==3.3.0" \
    "passlib[bcrypt]==1.7.4" \
    httpx==0.25.2

# Install Development tools (optional but useful)
RUN pip3 install --no-cache-dir \
    pytest==7.4.3 \
    pytest-asyncio==0.21.1 \
    black==23.11.0 \
    flake8==6.1.0

# Create working directory
WORKDIR /workspace

# Create directories structure (สำหรับ workspace)
RUN mkdir -p /workspace && chmod -R 777 /workspace

# Setup Hugging Face cache (ช่วยลด re-download ในแต่ละ Pod)
ENV HF_HOME=/workspace/.cache/huggingface
RUN mkdir -p $HF_HOME && chmod -R 777 /workspace

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CUDA_VISIBLE_DEVICES=0
# ป้องกัน freeze ของ CTranslate2/CUDA
ENV CT2_USE_CUDA_GRAPH=0
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4
# Default provider: faster-whisper (สามารถ override ได้)
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=medium
ENV WHISPER_DEVICE=auto
# เริ่มด้วย VAD=false (ผ่านแล้วค่อยเปิด true)
ENV WHISPER_VAD_FILTER=false
# Timezone (ตั้งไว้แล้วด้านบน แต่ตั้งซ้ำเพื่อความแน่ใจ)
ENV TZ=Asia/Bangkok
ENV TZDIR=/usr/share/zoneinfo

# Expose ports (สำหรับ services ที่จะ start แบบ Direct mode)
# Port 22: SSH (สำหรับ RunPod SSH access)
# Port 8001: Transcription API
# Port 8002: Whisper API (optional)
# Port 6379: Redis
# Port 8010: Dashboard/Management API
EXPOSE 22 8001 8002 6379 8010

# ⚠️ ไม่มี CMD - Image นี้เป็น complete base
# User ต้อง:
# 1. Clone repository: git clone <repo> /workspace/transcription-service
# 2. Start services: bash scripts/pod/start-services-direct.sh
#    หรือ bash scripts/pod/start-pod.sh
#
# ✅ ไม่ต้องรัน install-dependencies.sh อีกต่อไป!

# Default: Keep container running (wait for user to start services)
# Start SSH server in background (สำหรับ RunPod SSH access)
# ⚠️ หมายเหตุ: RunPod มักจะจัดการ SSH service เอง แต่เราติดตั้งและเปิดพอร์ท 22 ไว้
CMD ["/bin/bash", "-c", "echo '🚀 Base Image Ready - All Dependencies Installed!'; echo '📋 Base Image: pytorch/pytorch:2.1.0-cuda11.8-cudnn8-devel'; echo '📋 Python: $(python3 --version)'; echo '📋 PyTorch: $(python3 -c \"import torch; print(torch.__version__)\" 2>/dev/null || echo \"N/A\")'; echo '📋 SSH: Starting SSH server on port 22...'; mkdir -p /var/run/sshd; /usr/sbin/sshd -D & sleep 2 && echo '✅ SSH server started on port 22'; echo '📋 Next steps:'; echo '   1. Clone repo: git clone <repo> /workspace/transcription-service'; echo '   2. Start services: bash scripts/pod/start-pod.sh'; echo '   ✅ No need to run install-dependencies.sh!'; echo ''; tail -f /dev/null"]

