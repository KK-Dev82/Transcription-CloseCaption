# ============================================================================
# Transcription Service - RunPod Environment Configuration
# ============================================================================
# Last Updated: 2024-12-04
# Based on: QUEUE_ARCHITECTURE_FINAL.md (Production-Ready Design)
# ============================================================================
# หมายเหตุ: Container RAM ที่แบ่งให้ = 62 GB (ใช้เป็นหลักในการคำนวณ worker/queue)

# ----------------------------------------------------------------------------
# Environment & Storage
# ----------------------------------------------------------------------------
ENVIRONMENT=runpod
# เปลี่ยนเป็น sqlite เพื่อเพิ่มความเร็วในการ query (เร็วกว่า JSON 10-100 เท่า)
STORAGE_TYPE=sqlite
SQLITE_DB_PATH=/workspace/transcription-service/storage/database.db
# JSON_STORAGE_DIR=/workspace/transcription-service/storage  # ไม่ใช้แล้ว แต่เก็บไว้สำหรับ rollback

# ----------------------------------------------------------------------------
# Temporary Files Management
# ----------------------------------------------------------------------------
# SAVE_TEMP_FILES: เก็บไฟล์ชั่วคราว (wav, temp folders) หรือไม่
# - not_save: ลบไฟล์ชั่วคราวทันทีหลัง transcribe เสร็จ (ประหยัด volume)
# - save: เก็บไฟล์ชั่วคราวไว้ (สำหรับ debugging หรือการใช้งาน audio player ใน Dashboard)
SAVE_TEMP_FILES=not_save

# ----------------------------------------------------------------------------
# RabbitMQ Configuration
# ----------------------------------------------------------------------------
RABBITMQ_HOST=178.128.105.100
RABBITMQ_PORT=5672
RABBITMQ_USER=senate
RABBITMQ_PASSWORD=qP2VtHz6fAX4xDksEpMrLT
RABBITMQ_VHOST=/

# RabbitMQ Connection Settings
RABBITMQ_HEARTBEAT_TIMEOUT=1800 
RABBITMQ_BLOCKED_TIMEOUT=600
RABBITMQ_CONNECTION_CHECK_INTERVAL=30

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_URL=redis://default:Guls3SwcxCfzYNoigtrlNq7bKZWklCCf@redis-12598.c252.ap-southeast-1-1.ec2.cloud.redislabs.com:12598

# ----------------------------------------------------------------------------
# Whisper Provider Configuration
# ----------------------------------------------------------------------------
WHISPER_PROVIDER=faster-whisper
WHISPER_API_URL=http://localhost:8002
# ทดลอง large-v3-turbo (CTranslate2): เร็วขึ้น, คุณภาพใกล้ large-v3
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# WHISPER_MODEL=models--Vinxscribe--biodatlab-whisper-th-medium-faster
# WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_DEVICE=cuda
WHISPER_USE_THREAD_LOCAL=false

# Faster-Whisper Specific Configuration
#WHISPER_COMPUTE_TYPE=float16
# int8_float16 ลดคุณภาพเพื่อความเร็ว
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_BATCH_SIZE=16

# Batched Inference Pipeline
WHISPER_USE_BATCHED=true  # ปิดเพราะต้องการปิด VAD (BatchedInferencePipeline ต้องการ VAD)

# Number of GPUs
NUM_GPUS=1
# NUM_GPUS=2

# ----------------------------------------------------------------------------
# Worker Allocation: CC (Close Caption) vs Transcription (file)
# ----------------------------------------------------------------------------
# ต้องการ: Transcription (file) เยอะกว่า CC แต่ต้องมี worker สำหรับ CC เสมอ
# GPU_WORKERS_PER_GPU: จำนวน worker ต่อ 1 GPU รวม
# GPU_WORKERS_FOR_CC_PER_GPU: ในนั้นกี่ตัวที่ฟัง priority (สำหรับ CC) — ต้องอย่างน้อย 1
#   - Worker ที่ฟัง priority + gpu$i = รับได้ทั้ง CC และงาน file
#   - Worker ที่ฟังแค่ gpu$i = รับเฉพาะงาน file (Transcription) — จำนวนต้องมากกว่า CC
# ตัวอย่าง: GPU_WORKERS_PER_GPU=10, GPU_WORKERS_FOR_CC_PER_GPU=2
#   → CC: 2 workers/GPU (มีสำหรับ CC เสมอ), file-only: 8 workers/GPU (Transcription เยอะกว่า CC)
GPU_WORKERS_FOR_CC_PER_GPU=2

#WHISPER_BEAM_SIZE=3
WHISPER_BEAM_SIZE=3 # ยิ่งน้อย ยิ่งเร็ว

WHISPER_BEST_OF=1

WHISPER_CONDITION_ON_PREVIOUS_TEXT=true  # ปิดเพื่อลด latency (chunked processing ไม่จำเป็น)

WHISPER_VAD_FILTER=true  # ปิดเพื่อลด latency และ overhead

# ----------------------------------------------------------------------------
# GPU Configuration
# ----------------------------------------------------------------------------
#CUDA_VISIBLE_DEVICES=0 # Single GPU only
CUDA_VISIBLE_DEVICES=0 # Multi GPU (2 GPUs)
WHISPER_CUBLAS=1

# GPU Transcription Settings
GPU_TRANSCRIPTION_MAX_RETRIES=3
GPU_TRANSCRIPTION_RETRY_DELAY=5.0

# ----------------------------------------------------------------------------
# Timezone
# ----------------------------------------------------------------------------
TZ=Asia/Bangkok
TZDIR=/usr/share/zoneinfo

# ----------------------------------------------------------------------------
# Concurrency & Queue Limits (เมื่อมี request เข้ามาเยอะ / worker เต็ม)
# ----------------------------------------------------------------------------
# จำกัดจำนวน request ที่ API รับพร้อมกัน (เกินแล้วคืน HTTP 429)
MAX_CONCURRENT_REQUESTS=25

# คิว Preprocess (extract + chunk): จำกัดจำนวน job ในคิว (queued + started)
# เต็มแล้ว request ใหม่จะได้ HTTP 429 พร้อมข้อความ "Queue เต็มแล้ว... โปรดรอซักครู่แล้วลองใหม่"
MAX_PREPROCESS_QUEUE_SIZE=25

# คิว GPU / Priority / CPU: ไม่มี max — job จะรอในคิวจน worker รับได้
# (CC/Live chunk ไปคิว priority ไม่ถูก reject)

# ----------------------------------------------------------------------------
# Queue Limits (Admission Control - สำหรับ display / RabbitMQ path)
# ----------------------------------------------------------------------------
MAX_QUEUE_REQUEST=51
MAX_QUEUE_EXTRACTION=80
MAX_QUEUE_TRANSCRIBE=30
RETRY_AFTER_SECONDS=30

# Admission Control Mode
# ----------------------------------------------------------------------------
ADMISSION_CONTROL_MODE=rabbitmq

# Legacy Queue Size Limit (Currently Used)
TRANSCRIPTION_MAX_QUEUE_SIZE=30

# ----------------------------------------------------------------------------
# Audio Extraction Configuration (25 Parallel)
# ----------------------------------------------------------------------------
AUDIO_EXTRACTION_MAX_WORKERS=4
EXTRACT_POOL_SIZE=4
FFMPEG_PROC_SEM=4
EXTRACT_TASK_TIMEOUT=900
# ตั้งเป็น 25 เพื่อรองรับ 25 audio extraction tasks พร้อมกัน
AUDIO_EXTRACTION_PREFETCH_COUNT=25

# ----------------------------------------------------------------------------
# Transcription Configuration (25 Parallel)
# ----------------------------------------------------------------------------
TRANSCRIPTION_MAX_WORKERS=25
TRANSCRIPTION_QUEUE_PREFETCH_COUNT=1
TRANSCRIPTION_PREFETCH_COUNT=25
# ตั้งเป็น 25 เพื่อรองรับ 25 transcription request tasks พร้อมกัน
TRANSCRIPTION_REQUEST_PREFETCH_COUNT=25

# ใช้ CPU workers หลายตัวเพื่อรองรับ concurrent requests (ดู MAX_PREPROCESS_QUEUE_SIZE ด้านบน)
NUM_PREPROCESS_WORKERS=8
NUM_CPU_WORKERS=8

# GPU_CONCURRENCY: จำนวน concurrent GPU tasks
# สำหรับ RTX 4000 Ada (20GB VRAM) + Base model (~1GB shared + buffers):
#   - 25 = ~3.5GB VRAM (พอสำหรับ 20GB) ✅
#   - 1 = ทดสอบคุณภาพ (ทีละ 1 task)
GPU_CONCURRENCY=2 # GPU_WORKERS_PER_GPU ← ใช้ตัวนี้แทน
CHUNK_INFLIGHT_LIMIT_PER_JOB=2 # 1 GPU: 2 พอ (1 รัน + 1 รอคิว)
CHUNK_ENQUEUE_WINDOW_SIZE=2 # 1 GPU: 2 chunks ครั้งแรก (ไม่ต้องรอคิวยาว)
GPU_WORKERS_PER_GPU=2 # 1 GPU: 2 workers (1 CC+file, 1 file-only) — GPU ทำทีละ 1 chunk
ALLOW_CPU_FALLBACK=false
USE_QUORUM_QUEUES=true 
ENABLE_DLX=true
# Priority Queue for Close Caption (0-10)
# CloseCaption (realtime_chunks) → priority 10 (สูงสุด)
# Normal transcription → priority 5 (ปกติ)
RABBITMQ_MAX_PRIORITY=10

# 3-Queue Architecture Enable/Disable
# true = ใช้ 3-Queue Architecture (request → extraction → transcription)
# false = ใช้ Legacy Architecture (ตรงไปยัง transcription_queue)
USE_3QUEUE_ARCHITECTURE=true


# ----------------------------------------------------------------------------
# CloseCaption Configuration
# ----------------------------------------------------------------------------

# เปิดใช้งาน CloseCaption
CC_ENABLED=true

# Model (Systran small — ใช้ร่วมกับ Transcription)
# CC_MODEL_SIZE=Systran/faster-whisper-small
# ใช้โมเดลเดียวกับ Transcription (large-v3-turbo CTranslate2)
CC_MODEL_SIZE=deepdml/faster-whisper-large-v3-turbo-ct2
# CC_MODEL_SIZE=models--Vinxscribe--biodatlab-whisper-th-medium-faster
CC_DEVICE=auto
CC_COMPUTE_TYPE=int8_float16

# Chunking (3s hop + 0.6s overlap)
CC_CHUNK_HOP=4.0
CC_CHUNK_OVERLAP=0.8 #Default 0.6

# Whisper Parameters (Profile TH-CC-RT v1)
CC_BEAM_SIZE=2
CC_TEMPERATURE=0.0
CC_VAD_FILTER=true
CC_CONDITION_ON_PREVIOUS_TEXT=false

# Dedupe & Postprocess
CC_DEDUPE_ENABLED=true
CC_POSTPROCESS_ENABLED=true
CC_POSTPROCESS_NORMALIZE=true

# WebSocket Live Caption: ระยะเวลาที่รอ (ปรับให้รอนานขึ้น เพื่อให้ได้ประโยคสมบูรณ์ อ่านรู้เรื่อง)
FE_CC_WINDOW_SECONDS=4.0
FE_CC_STEP_SECONDS=1.5
FE_CC_MIN_WINDOW_SECONDS=2.5
FE_CC_SILENCE_THRESHOLD=0.8
# WebSocket Live Caption stability (แก้ 1011 ping timeout / 1006 abnormal close)
FE_CC_UPLINK_KEEPALIVE_SECONDS=15
UVICORN_WS_PING_INTERVAL=20
UVICORN_WS_PING_TIMEOUT=60

# ตรวจสอบคุณภาพเสียงสตรีม: เปิดแล้วจะ log สถิติ (rms, peak, dBFS) ทุก chunk + บันทึก WAV ตัวอย่างที่ storage/cc_debug_audio/
# FE_CC_DEBUG_SAVE_AUDIO=true
# FE_CC_DEBUG_SAVE_AUDIO_MAX_FILES=10
# FE_CC_DEBUG_SAVE_AUDIO_DIR=storage/cc_debug_audio

# ----------------------------------------------------------------------------
# Worker Monitor Configuration
# ----------------------------------------------------------------------------
ENABLE_WORKER_MONITOR=true
WORKER_MONITOR_INTERVAL=60
WORKER_MONITOR_MAX_RESTARTS=5

# ----------------------------------------------------------------------------
# Task Timeout Configuration
# ----------------------------------------------------------------------------
# TRANSCRIPTION_TASK_TIMEOUT_SECONDS: Default timeout สำหรับ transcription tasks (seconds)
# สำหรับไฟล์ 10 นาที ควรใช้ ~1800s (30 min), สำหรับไฟล์ยาวอาจเพิ่มเป็น 3600s (1 hour)
TRANSCRIPTION_TASK_TIMEOUT_SECONDS=3600

# TASK_TIMEOUT_SECONDS: Default timeout สำหรับ tasks ทุกประเภท (seconds)
# ใช้เป็น default ถ้าไม่ระบุเฉพาะ task type
TASK_TIMEOUT_SECONDS=1800  # 30 minutes default

# TRANSCRIPTION_PROCESSING_TIMEOUT_SECONDS: Timeout สำหรับ transcription processing step (seconds)
# ควรสั้นกว่า TRANSCRIPTION_TASK_TIMEOUT_SECONDS เพื่อให้มีเวลาเก็บ cleanup
TRANSCRIPTION_PROCESSING_TIMEOUT_SECONDS=1800  # 30 minutes

# ----------------------------------------------------------------------------
# Stuck Task Detection Configuration
# ----------------------------------------------------------------------------
# STUCK_TASK_THRESHOLD_SECONDS: Threshold สำหรับ detect stuck tasks (seconds)
# Task จะถูก consider เป็น stuck ถ้าไม่มี heartbeat เป็นเวลานานกว่านี้
STUCK_TASK_THRESHOLD_SECONDS=600  # 10 minutes

# STUCK_TASK_CHECK_INTERVAL_SECONDS: Interval สำหรับ background monitor ตรวจสอบ stuck tasks (seconds)
# Background task จะตรวจสอบ stuck tasks ทุก X seconds
STUCK_TASK_CHECK_INTERVAL_SECONDS=60  # 1 minute

# ----------------------------------------------------------------------------
# Phase 5: Cleanup Service Configuration
# ----------------------------------------------------------------------------
CLEANUP_INTERVAL_SECONDS=3600
TEMP_FOLDER_MAX_AGE_HOURS=24
DISK_SPACE_WARNING_THRESHOLD_GB=10.0
DISK_SPACE_CRITICAL_THRESHOLD_GB=5.0

# ----------------------------------------------------------------------------
# Worker Type
# ----------------------------------------------------------------------------
VIDEO_WORKER_TYPE=async

# ----------------------------------------------------------------------------
# Backend API Configuration (สำหรับ Dictionary Service)
# ----------------------------------------------------------------------------
# Backend API Base URL สำหรับดึง Dictionary words (สำหรับ initial_prompt)
# Staging: ใช้ VPN IP หรือ Frontend Proxy
# BACKEND_API_BASE_URL=http://10.200.22.61:5173
# หรือผ่าน Frontend Proxy: https://staging-ph2.bms.senate.go.th
BACKEND_API_BASE_URL=https://staging-ph2.bms.senate.go.th
# หรือ BACKEND_URL (alias) - จะใช้ถ้า BACKEND_API_BASE_URL ไม่มี
# BACKEND_URL=http://10.200.22.61:5173

# FileService URL (สำหรับ Staging)
# FILE_SERVICE_URL=http://10.200.22.60:5182
# หรือผ่าน Frontend Proxy: https://staging-ph2.bms.senate.go.th/fileservice
FILE_SERVICE_URL=https://staging-ph2.bms.senate.go.th/fileservice


# Dashboard
DASHBOARD_BASE_URL=https://n2l8ke53h14aaw-8020.proxy.runpod.net
# Disable cuDNN to avoid compatibility issues
CUDNN_DISABLE=0

# cuDNN library path
LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}