# Base Image ใหม่สำหรับ Transcription Service (CUDA 12.1.1 + cuDNN)
# ⭐ Image นี้มี dependencies ทั้งหมดติดตั้งไว้แล้ว ไม่ต้อง install ใหม่ทุกครั้งที่ restart POD
#
# Base Image: runpod/pytorch:2.2.0-py3.10-cuda12.1.1-devel-ubuntu22.04
# ✅ ใช้ RunPod Official Image ที่มี PyTorch 2.2.0 + CUDA 12.1.1 + cuDNN + Build Tools พร้อมแล้ว
# ✅ มี Python 3.10 (ชัดเจน)
# ✅ PyTorch 2.2.0 (ใหม่กว่า 2.1.0 - มี performance improvements)
# ✅ CUDA 12.1.1 (patch version ใหม่กว่า)
# ✅ รองรับ RTX 4000 Ada Generation (CUDA 12.x)
# ✅ รองรับ faster-whisper 1.2.1 + CTranslate2 4.6.2+ (cuDNN 9)
#
# Build for linux/amd64 (RunPod)
# ⚠️ สำคัญ: RunPod ใช้ linux/amd64 (x86_64)
#    ถ้า build บน macOS (ARM64) ต้องใช้ --platform=linux/amd64
#    Script จะ auto-detect และใช้ --platform อัตโนมัติ
#
# Build:
#   docker build -f Dockerfile.base-new-cuda12 -t your-registry/transcription-base-cuda12:latest .
#
# Push:
#   docker push your-registry/transcription-base-cuda12:latest
#
# ✅ ข้อดี:
# - ไม่ต้องรัน install-dependencies.sh ทุกครั้งที่ restart POD
# - Start services ได้ทันทีหลัง clone repo
# - ลดเวลา startup และความเสี่ยงจาก network issues
# - ใช้ PyTorch Official Image ที่เสถียร
# - มี Build Tools (devel image) + Python 3.10
# - รองรับ CUDA 12.1 + cuDNN 9 (เร็วที่สุดสำหรับ RTX 4000 Ada)
# - รองรับ faster-whisper 1.2.1 (ล่าสุด)

FROM runpod/pytorch:2.2.0-py3.10-cuda12.1.1-devel-ubuntu22.04

# Set environment variables for non-interactive installation (ต้องตั้งก่อน RUN apt-get)
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV TZDIR=/usr/share/zoneinfo

# Install system dependencies
# ✅ Devel image มี build tools อยู่แล้ว แต่ติดตั้งเพิ่มเพื่อความแน่ใจ
RUN apt-get update && apt-get install -y \
    # Build tools (devel image มีอยู่แล้วบางส่วน แต่ติดตั้งเพื่อความแน่ใจ)
    build-essential \
    cmake \
    git \
    git-lfs \
    wget \
    curl \
    # Redis (สำหรับ local Redis service ใน Direct mode)
    redis-server \
    # Utilities
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio/Video processing
    ffmpeg \
    libmagic1 \
    libsndfile1 \
    libportaudio2 \
    libasound2-dev \
    portaudio19-dev \
    # Network tools
    netcat \
    telnet \
    jq \
    # SSH (สำหรับ remote access)
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

# Initialize git-lfs (สำหรับโมเดล/ไฟล์ใหญ่ใน Git)
RUN git lfs install

# Setup SSH (optional - สำหรับ remote access)
# ⚠️ หมายเหตุ: SSH จะทำงานได้ก็ต่อเมื่อ container ถูก expose port 22
#    และมี SSH keys หรือ password authentication ตั้งค่าไว้
#    แต่ต้องมี SSH server ติดตั้งและเปิดพอร์ท 22 ไว้
RUN mkdir -p /var/run/sshd && \
    # ตั้งค่า SSH config พื้นฐาน
    echo 'Port 22' >> /etc/ssh/sshd_config && \
    echo 'ListenAddress 0.0.0.0' >> /etc/ssh/sshd_config && \
    echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config && \
    echo 'PubkeyAuthentication yes' >> /etc/ssh/sshd_config && \
    # สร้าง SSH directory สำหรับ root
    mkdir -p /root/.ssh && \
    chmod 700 /root/.ssh && \
    touch /root/.ssh/authorized_keys && \
    chmod 600 /root/.ssh/authorized_keys

# Base image มี PyTorch 2.2.0+cu121 อยู่แล้ว
# ตรวจสอบ Python และ PyTorch version (optional - for verification)
RUN python3 --version && \
    python3 -c "import torch; print(f'✅ PyTorch: {torch.__version__}'); print(f'✅ CUDA available: {torch.cuda.is_available()}'); print(f'✅ CUDA version: {torch.version.cuda}'); print(f'✅ cuDNN version: {torch.backends.cudnn.version() if torch.backends.cudnn.is_available() else \"N/A\"}')" || true

# Base image มี PyTorch 2.2.0+cu121 อยู่แล้ว - ไม่ต้อง upgrade
# ใช้เวอร์ชันที่มีอยู่ (2.2.0) เพื่อความเสถียรและ performance ที่ดีกว่า

# Install faster-whisper 1.2.1 with compatible versions (CUDA 12.1.1)
# ⚠️ ตรวจสอบ cuDNN version ก่อน - ถ้า cuDNN 8.x ใช้ CTranslate2 4.4.0, ถ้า cuDNN 9.x ใช้ 4.6.2+
# ✅ ใช้ CTranslate2 4.6.2+ เพื่อรองรับ cuDNN 9 (เร็วที่สุด)
#    ถ้ามีปัญหา cuDNN version mismatch ให้เปลี่ยนเป็น ctranslate2==4.4.0
RUN pip3 install --no-cache-dir \
    numpy<2.0.0 \
    "ctranslate2>=4.6.2" \
    "faster-whisper==1.2.1" || \
    (echo "⚠️  CTranslate2 4.6.2+ failed, trying 4.4.0 for cuDNN 8..." && \
     pip3 install --no-cache-dir \
     numpy<2.0.0 \
     "ctranslate2==4.4.0" \
     "faster-whisper==1.2.1")

# Install Core FastAPI dependencies
RUN pip3 install --no-cache-dir \
    fastapi==0.104.1 \
    "uvicorn[standard]==0.24.0" \
    python-multipart==0.0.6 \
    websockets==12.0 \
    pydantic==2.5.0

# Install RabbitMQ and async dependencies
RUN pip3 install --no-cache-dir \
    pika==1.3.2 \
    "aio-pika==9.3.0" \
    aiohttp==3.9.1 \
    httpx==0.25.2

# Install Redis and file handling
RUN pip3 install --no-cache-dir \
    "redis[hiredis]==5.0.1" \
    aiofiles==23.2.1 \
    python-magic==0.4.27

# Install Audio/Video processing
RUN pip3 install --no-cache-dir \
    librosa==0.10.1 \
    soundfile==0.12.1 \
    pydub==0.25.1 \
    ffmpeg-python==0.2.0

# Install OpenAI Whisper (backup provider)
RUN pip3 install --no-cache-dir \
    openai-whisper==20231117

# Install Thai NLP (optional - fallback mode if tzdata missing)
RUN pip3 install --no-cache-dir \
    pythainlp==4.0.2 || echo "⚠️  pythainlp installation failed (may need tzdata)"

# Install other dependencies
RUN pip3 install --no-cache-dir \
    python-json-logger==2.0.7 \
    requests==2.31.0 \
    python-dotenv==1.0.0 \
    attacut==1.0.6

# Set working directory
WORKDIR /workspace

# Create necessary directories
RUN mkdir -p uploads storage/transcriptions storage/metadata storage/captions temp models test-files

# Set default environment variables
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=medium
ENV WHISPER_DEVICE=cuda
ENV WHISPER_COMPUTE_TYPE=float16
ENV CT2_USE_CUDA_GRAPH=0

# Expose ports
EXPOSE 8010 8020 8030

# Default command (can be overridden)
CMD ["/bin/bash"]

