# Dockerfile สำหรับ HP Z2 Workstation
# สร้างจาก Environment ที่ทำงานได้บน RunPod
#
# Base Image: ใช้ PyTorch Official image
# CUDA Version: 11.8 (compatible กับ CUDA 12.x driver)
#
# Build:
#   docker build -f Dockerfile.z2-base -t kk-transcription-z2-base:latest .
#
# Usage:
#   docker run --gpus all -it kk-transcription-z2-base:latest

FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build tools
    build-essential \
    cmake \
    git \
    git-lfs \
    wget \
    curl \
    # Redis (สำหรับ local Redis service)
    redis-server \
    # Utilities
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio/Video processing
    ffmpeg \
    # Network tools
    netcat \
    telnet \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Initialize git-lfs
RUN git lfs install

# Install PyTorch with CUDA support
# Base image มี PyTorch 2.1.0+cu118 อยู่แล้ว แต่ upgrade เป็น 2.1.1 (ถ้าต้องการ)
RUN pip3 install --no-cache-dir --upgrade \
    torch==2.1.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu118 || \
    pip3 install --no-cache-dir \
    torch==2.1.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu118

# Install faster-whisper with compatible versions (CUDA 11.8)
# ⚠️ สำคัญ: ใช้ CTranslate2 4.4.0 (ไม่ใช่ 4.5.0) เพื่อรองรับ cuDNN 8.7
RUN pip3 install --no-cache-dir \
    numpy==1.26.4 \
    "ctranslate2==4.4.0" \
    "faster-whisper==1.0.2"

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    requests \
    aiohttp \
    aiofiles \
    redis \
    pika \
    python-dotenv \
    tzdata \
    ffmpeg-python

# Create working directory
WORKDIR /workspace

# Create directories structure
RUN mkdir -p /workspace/transcription-service/{uploads,temp,storage} && \
    chmod -R 777 /workspace

# Setup Hugging Face cache
ENV HF_HOME=/workspace/.cache/huggingface
RUN mkdir -p $HF_HOME && chmod -R 777 /workspace

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_VISIBLE_DEVICES=0

# ป้องกัน freeze ของ CTranslate2/CUDA
ENV CT2_USE_CUDA_GRAPH=0
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4

# Library paths สำหรับ cuDNN และ CUDA
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/torch/lib:/usr/local/cuda-11.8/targets/x86_64-linux/lib:$LD_LIBRARY_PATH

# สร้าง symlink สำหรับ libcublas.so.12 (ถ้ามี libcublas.so.11)
RUN if [ -f /usr/local/cuda-11.8/targets/x86_64-linux/lib/libcublas.so.11.11.3.6 ]; then \
        cd /usr/local/cuda-11.8/targets/x86_64-linux/lib && \
        ln -sf libcublas.so.11.11.3.6 libcublas.so.12 || true; \
    fi

# Default provider settings
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=medium
ENV WHISPER_DEVICE=cuda
ENV WHISPER_VAD_FILTER=false

# Expose ports
EXPOSE 8001 8002 6379

# Default: Keep container running
CMD ["/bin/bash", "-c", "echo '🚀 Z2 Base Image Ready'; echo '📋 Next steps:'; echo '   1. Clone repo: git clone <repo> /workspace/transcription-service'; echo '   2. Start services: bash scripts/pod/start-services-direct.sh'; echo ''; tail -f /dev/null"]

