# Development Environment Variables
ENVIRONMENT=development
PYTHONPATH=/app

# Storage Configuration
STORAGE_TYPE=sqlite
SQLITE_DB_PATH=/app/storage/database.db

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Whisper Configuration
WHISPER_MODEL_PATH=/app/models
WHISPER_HOST=whisper
WHISPER_PORT=8002
WHISPER_API_URL=http://transcription-whisper-staging:8002

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Logging
LOG_LEVEL=DEBUG
