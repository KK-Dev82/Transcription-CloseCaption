# Dockerfile สำหรับ Local Development with Faster-Whisper
# รองรับทั้ง CPU และ GPU (ถ้ามี)
#
# Usage:
#   CPU Mode: docker build -f Dockerfile.local-faster-whisper -t kk-transcription:local-faster-whisper .
#   GPU Mode:  docker build -f Dockerfile.local-faster-whisper --build-arg GPU_MODE=true -t kk-transcription:local-faster-whisper .

ARG GPU_MODE=false
ARG CUDA_VERSION=12.1.0

# Builder stage - ใช้ Python slim สำหรับ build
FROM python:3.11-slim as builder

# ตั้งค่า environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

# ติดตั้ง build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    cmake \
    git \
    wget \
    curl \
    ffmpeg \
    libmagic1 \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# สร้าง working directory
WORKDIR /app

# ติดตั้ง PyTorch (รองรับทั้ง CPU และ GPU)
# ถ้า GPU_MODE=true → ติดตั้ง PyTorch with CUDA
# ถ้า GPU_MODE=false → ติดตั้ง PyTorch CPU-only
RUN if [ "$GPU_MODE" = "true" ]; then \
        pip install --no-cache-dir \
            torch==2.1.1 \
            torchaudio==2.1.1 \
            --index-url https://download.pytorch.org/whl/cu118; \
    else \
        pip install --no-cache-dir \
            torch==2.1.1 \
            torchaudio==2.1.1 \
            --index-url https://download.pytorch.org/whl/cpu; \
    fi

# คัดลอก requirements และติดตั้ง Python dependencies
COPY docs/requirements-core.txt .
RUN pip install --no-cache-dir --user -r requirements-core.txt

# ติดตั้ง faster-whisper และ dependencies (หลัง requirements เพื่อให้ dependencies ถูกติดตั้งก่อน)
RUN pip install --no-cache-dir --user \
    faster-whisper==1.0.3 \
    typing_extensions>=4.0.0 \
    idna>=3.0

# Production stage - ใช้ Python slim สำหรับ CPU mode
FROM python:3.11-slim as final

# ตั้งค่า environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:$PATH"

# ติดตั้ง runtime dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libmagic1 \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# สร้าง working directory
WORKDIR /app

# คัดลอก Python packages จาก builder stage
COPY --from=builder /root/.local /root/.local

# ติดตั้ง dependencies ที่ขาดหายไป (ถ้ายังไม่มี)
# Note: torch ต้องติดตั้งใน final stage เพราะขนาดใหญ่และอาจจะไม่ได้ copy จาก builder
RUN pip install --no-cache-dir --user \
    typing_extensions>=4.0.0 \
    torch==2.1.1 \
    torchaudio==2.1.1 \
    --index-url https://download.pytorch.org/whl/cpu || true

# ลบ cache และ files ที่ไม่จำเป็น
RUN find /root/.local -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
    && find /root/.local -type f -name "*.pyc" -delete 2>/dev/null || true

# คัดลอก source code
COPY . .

# สร้างโฟลเดอร์ที่จำเป็น
RUN mkdir -p uploads temp storage models test-files

# คัดลอก entrypoint script
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# ตั้งค่า permissions
RUN chmod +x main.py

# Set default environment variables for faster-whisper
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=base
ENV WHISPER_DEVICE=auto
ENV WHISPER_COMPUTE_TYPE=float32

# Note: สำหรับ GPU mode ให้ใช้ Dockerfile.local-faster-whisper-gpu แทน
# หรือตั้งค่า environment variables ใน docker-compose.yml

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# ใช้ entrypoint script
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# รัน application
CMD ["sh", "-c", "if [ \"$ENVIRONMENT\" = \"development\" ]; then uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload --log-level info; else uvicorn app.main:app --host 0.0.0.0 --port 8001 --log-level info; fi"]

