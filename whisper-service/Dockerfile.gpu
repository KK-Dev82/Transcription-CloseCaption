# Dockerfile สำหรับ GPU (ใช้ได้ทั้ง RunPod และ HP Z2 Workstation)
# Build whisper.cpp with CUDA support (CUBLAS)
#
# Base Image: nvidia/cuda:12.1.0-base-ubuntu22.04
# รองรับ CUDA 12.1+ (RunPod: 12.1.1/12.4.1, HP Z2: 12.1.0)

FROM --platform=linux/amd64 nvidia/cuda:12.1.0-base-ubuntu22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    python3 \
    python3-pip \
    curl \
    libcublas-dev \
    libcublas12 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install --no-cache-dir fastapi uvicorn pydantic

# Clone and build whisper.cpp with CUDA support
RUN git clone https://github.com/ggml-org/whisper.cpp.git /app/whisper.cpp \
    && cd /app/whisper.cpp \
    && make clean \
    && GGML_CUBLAS=1 make -j$(nproc) \
    && mkdir -p /app/whisper.cpp/build/bin \
    && cp main /app/whisper.cpp/build/bin/whisper-cli \
    && chmod +x /app/whisper.cpp/build/bin/whisper-cli

# Download models (base, small, medium)
RUN cd /app/whisper.cpp \
    && ./models/download-ggml-model.sh base \
    && ./models/download-ggml-model.sh small \
    && ./models/download-ggml-model.sh medium || echo "⚠️  Medium model download failed, continuing..."

# Set working directory
WORKDIR /app

# Create directories
RUN mkdir -p /app/models /app/audio /app/output /app/temp

# Copy models to accessible location
RUN cp /app/whisper.cpp/models/ggml-*.bin /app/models/ 2>/dev/null || true

# Set PATH and CUDA environment
ENV PATH="/app/whisper.cpp:${PATH}"
ENV PATH="/app/whisper.cpp/build/bin:${PATH}"
ENV CUDA_VISIBLE_DEVICES=0
ENV WHISPER_CUBLAS=1

# Copy Whisper API Service
COPY whisper_api.py /app/whisper_api.py

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Default command
CMD ["python3", "/app/whisper_api.py"]

