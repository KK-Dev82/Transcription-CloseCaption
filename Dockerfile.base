# ============================================================================
# Base Image: Self-Hosted GPU Server
# ทดแทน runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
#
# สิ่งที่ image นี้มี:
#   - Ubuntu 24.04 + CUDA 12.8.1 + cuDNN 9
#   - PyTorch 2.8.0 + torchaudio (cu128)
#   - Python 3.12 + pip packages (requirements.txt)
#   - FFmpeg, libmagic1, libsndfile1, sox และ system tools
#   - ldconfig + LD_LIBRARY_PATH สำหรับ cuDNN
#
# สิ่งที่ไม่ได้อยู่ใน image (mount volume):
#   - Application code → git clone/pull ที่ server แล้ว mount เข้า container
#   - Data files (uploads, storage, models, temp)
#
# Build:
#   docker buildx build --platform linux/amd64 \
#     -f Dockerfile.base \
#     -t kksenateacr.azurecr.io/kk-base:ubuntu2404-cuda128-torch280 \
#     --load .
#
# Update flow (ไม่ต้อง rebuild image):
#   1. git pull (บน server)
#   2. docker compose -f docker-compose.prod.yml restart transcription
# ============================================================================

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Bangkok

# ============================================================================
# 1. System packages
# ============================================================================
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev \
    git wget curl \
    ffmpeg libsndfile1 libsox-dev sox \
    libmagic1 \
    build-essential cmake \
    tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip && \
    python3 -m pip config set global.break-system-packages true

# ============================================================================
# 2. PyTorch 2.8.0 + torchaudio (CUDA 12.8)
# ============================================================================
RUN pip install --no-cache-dir --timeout 600 --retries 3 \
    torch==2.8.0 \
    torchaudio==2.8.0 \
    --index-url https://download.pytorch.org/whl/cu128

# ============================================================================
# 3. ldconfig + environment variables
# ============================================================================
RUN SITE_PKG=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib'))") && \
    echo "${SITE_PKG}/nvidia/cudnn/lib"  >  /etc/ld.so.conf.d/cudnn-cuda.conf && \
    echo "/usr/lib/x86_64-linux-gnu"     >> /etc/ld.so.conf.d/cudnn-cuda.conf && \
    echo "/usr/local/cuda-12.8/lib64"   >> /etc/ld.so.conf.d/cudnn-cuda.conf && \
    echo "/usr/local/cuda/lib64"         >> /etc/ld.so.conf.d/cudnn-cuda.conf && \
    ldconfig

RUN SITE_PKG=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib'))") && \
    echo "export LD_LIBRARY_PATH=${SITE_PKG}/nvidia/cudnn/lib:/usr/lib/x86_64-linux-gnu:/usr/local/cuda-12.8/lib64:/usr/local/cuda/lib64:\${LD_LIBRARY_PATH:-}" \
    > /etc/profile.d/cudnn-ctranslate2.sh

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:$PATH
ENV HF_HUB_ENABLE_HF_TRANSFER=0

# ============================================================================
# 4. Python dependencies (bake เข้า image — ไม่ต้องลงใหม่เวลา restart)
# ============================================================================
COPY requirements.txt /tmp/
RUN pip install --no-cache-dir --timeout 600 --retries 3 \
    -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Verify packages
RUN python3 -c "\
import ctranslate2; print(f'ctranslate2 {ctranslate2.__version__}'); \
from faster_whisper import WhisperModel; print('faster-whisper OK'); \
import torch; print(f'torch {torch.__version__}'); \
"

# ============================================================================
# 5. Working directory
# ============================================================================
WORKDIR /workspace/transcription-service

EXPOSE 8010 8002

CMD ["bash", "-c", "./scripts/pod/start-pod.sh && ./scripts/pod/start-rq-workers.sh && tail -f /dev/null"]
