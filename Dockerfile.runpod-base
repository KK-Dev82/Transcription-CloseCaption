# Minimal Base Image สำหรับ RunPod และ HP Z2 Workstation
# มีแค่ CUDA + Dependencies พื้นฐาน (ไม่ start services อัตโนมัติ)
#
# ใช้ได้ทั้ง:
# - RunPod: Pull image นี้ → Clone repo → Start services แบบ Direct mode
# - HP Z2: Pull image นี้ → Clone repo → Start services แบบ Direct mode
#
# ⚠️ หมายเหตุ:
# - Image นี้เป็น minimal base - ไม่มี services start อัตโนมัติ
# - User ต้อง clone repo และ run scripts/pod/start-services-direct.sh เอง
# - Z2 ต้องมี NVIDIA drivers และ nvidia-container-toolkit (ไม่ใช่ CUDA Toolkit)

# Build for linux/amd64 (RunPod and HP Z2)
# Note: Use --platform=linux/amd64 when building on ARM64 (MacOS M1/M2)
FROM nvidia/cuda:12.1.0-base-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build tools
    build-essential \
    cmake \
    git \
    wget \
    curl \
    # Python
    python3 \
    python3-pip \
    # Redis (สำหรับ local Redis service)
    redis-server \
    # Utilities
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio/Video processing
    ffmpeg \
    # Network tools
    netcat \
    telnet \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install Azure CLI (สำหรับ pull images จาก ACR)
RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash

# Install PyTorch with CUDA support
# CUDA 12.1 → PyTorch with CUDA 11.8 (backward compatible)
# Note: PyTorch 2.1.1 supports CUDA 11.8 (compatible with CUDA 12.1)
# For CUDA 12.1, use cu118 wheel (backward compatible)
RUN pip3 install --no-cache-dir \
    torch==2.1.1 \
    torchaudio==2.1.1 \
    --index-url https://download.pytorch.org/whl/cu118

# Install faster-whisper with compatible versions (CUDA 11.8)
# ตามคำแนะนำ: ctranslate2==4.5.0, faster-whisper==1.0.2, numpy==1.26.4
RUN pip3 install --no-cache-dir \
    numpy==1.26.4 \
    "ctranslate2==4.5.0" \
    "faster-whisper==1.0.2"

# Install Python dependencies (พื้นฐาน)
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    requests \
    aiohttp \
    aiofiles \
    redis \
    pika \
    python-dotenv \
    tzdata \
    ffmpeg-python

# Create working directory
WORKDIR /workspace

# Create directories structure (สำหรับ workspace)
RUN mkdir -p /workspace

# ⚠️ ไม่ copy setup scripts - ให้ user clone repo และ run scripts เอง
# ⚠️ ไม่มี CMD - ให้ user start services แบบ Direct mode เอง

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_VISIBLE_DEVICES=0
# ป้องกัน freeze ของ CTranslate2/CUDA
ENV CT2_USE_CUDA_GRAPH=0
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4
# Default provider: faster-whisper (สามารถ override ได้)
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=medium
ENV WHISPER_DEVICE=auto

# Expose ports (สำหรับ services ที่จะ start แบบ Direct mode)
EXPOSE 8001 8002 6379

# ⚠️ ไม่มี CMD - Image นี้เป็น minimal base
# User ต้อง:
# 1. Clone repository: git clone <repo> /workspace/transcription-service
# 2. Start services: bash scripts/pod/start-services-direct.sh
# หรือ
# 3. Use restart script: bash scripts/pod/restart-pod-services.sh

# Default: Keep container running (wait for user to start services)
CMD ["/bin/bash", "-c", "echo '🚀 Minimal Base Image Ready'; echo '📋 Next steps:'; echo '   1. Clone repo: git clone <repo> /workspace/transcription-service'; echo '   2. Start services: bash scripts/pod/restart-pod-services.sh'; echo ''; tail -f /dev/null"]

