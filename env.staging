# Staging Environment Configuration
ENVIRONMENT=staging
PYTHONPATH=/app

# Storage Configuration
STORAGE_TYPE=sqlite
SQLITE_DB_PATH=/app/storage/database.db

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Whisper Configuration
WHISPER_MODEL_PATH=/app/models
WHISPER_HOST=whisper
WHISPER_PORT=8002

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Logging
LOG_LEVEL=INFO

# Security (สำหรับ production ควรใช้ secrets)
JWT_SECRET_KEY=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Resource Limits
MAX_FILE_SIZE=500MB
MAX_CONCURRENT_TASKS=10

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
