# Complete Image สำหรับ RunPod - มี Dependencies ติดตั้งไว้แล้ว
# ⭐ Image นี้มี dependencies ทั้งหมดติดตั้งไว้แล้ว ไม่ต้อง install ใหม่ทุกครั้งที่ restart POD
#
# ใช้ได้ทั้ง:
# - RunPod: Pull image นี้ → Clone repo → Start services แบบ Direct mode (ไม่ต้อง install dependencies)
# - HP Z2: Pull image นี้ → Clone repo → Start services แบบ Direct mode
#
# ✅ ข้อดี:
# - ไม่ต้องรัน install-dependencies.sh ทุกครั้งที่ restart POD
# - Start services ได้ทันทีหลัง clone repo
# - ลดเวลา startup และความเสี่ยงจาก network issues
#
# ⚠️ หมายเหตุ:
# - Image นี้มี dependencies ครบถ้วนแล้ว
# - User แค่ clone repo และ start services ได้เลย
# - Z2 ต้องมี NVIDIA drivers และ nvidia-container-toolkit

# Build for linux/amd64 (RunPod and HP Z2)
# Note: Use --platform=linux/amd64 when building on ARM64 (MacOS M1/M2)
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build tools
    build-essential \
    cmake \
    git \
    git-lfs \
    wget \
    curl \
    # Redis (สำหรับ local Redis service ใน Direct mode)
    redis-server \
    # Utilities
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio/Video processing
    ffmpeg \
    # Timezone data (required for pythainlp)
    tzdata \
    # Network tools
    netcat \
    telnet \
    jq \
    # Audio libraries
    libmagic1 \
    libsndfile1 \
    libportaudio2 \
    libasound2-dev \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Initialize git-lfs (สำหรับโมเดล/ไฟล์ใหญ่ใน Git)
RUN git lfs install

# Install PyTorch with CUDA support
# Base image มี PyTorch 2.1.0+cu118 อยู่แล้ว แต่ต้อง upgrade เป็น 2.1.1
RUN pip3 install --no-cache-dir --upgrade \
    torch==2.1.1 \
    torchaudio==2.1.1 \
    --index-url https://download.pytorch.org/whl/cu118

# Install faster-whisper with compatible versions (CUDA 11.8)
# ใช้ CTranslate2 4.4.0 เพื่อให้ compatible กับ cuDNN 8 (ตาม install-dependencies.sh)
RUN pip3 install --no-cache-dir \
    numpy==1.26.4 \
    "ctranslate2==4.4.0" \
    "faster-whisper==1.0.3"

# Install Core FastAPI dependencies
RUN pip3 install --no-cache-dir \
    fastapi==0.104.1 \
    "uvicorn[standard]==0.24.0" \
    python-multipart==0.0.6 \
    pydantic==2.5.0

# Install RabbitMQ and async dependencies
RUN pip3 install --no-cache-dir \
    aiofiles==23.2.1 \
    "aio-pika==9.3.0" \
    pika==1.3.2 \
    aiohttp==3.9.1 \
    requests==2.31.0

# Install Redis client
RUN pip3 install --no-cache-dir \
    "redis[hiredis]==5.0.1"

# Install Whisper dependencies
RUN pip3 install --no-cache-dir \
    openai-whisper==20231117

# Install Audio processing libraries
RUN pip3 install --no-cache-dir \
    librosa==0.10.1 \
    soundfile==0.12.1 \
    pydub==0.25.1

# Install File handling
RUN pip3 install --no-cache-dir \
    python-magic==0.4.27

# Install JSON and data handling
RUN pip3 install --no-cache-dir \
    python-json-logger==2.0.7

# Install Async and concurrency
RUN pip3 install --no-cache-dir \
    asyncio-mqtt==0.16.1

# Install Message Queue
# (aio-pika และ pika ติดตั้งไปแล้วข้างบน)

# Install Utilities
RUN pip3 install --no-cache-dir \
    python-dotenv==1.0.0 \
    click==8.1.7 \
    tqdm==4.66.1

# Install Thai NLP
RUN pip3 install --no-cache-dir \
    pythainlp==4.0.2 \
    attacut==1.0.6

# Install Dashboard dependencies
RUN pip3 install --no-cache-dir \
    jinja2==3.1.2 \
    psutil==5.9.6 \
    docker==6.1.3

# Install FFmpeg Python wrapper
RUN pip3 install --no-cache-dir \
    ffmpeg-python==0.2.0

# Install Additional dependencies from requirements.txt
RUN pip3 install --no-cache-dir \
    sqlalchemy==2.0.23 \
    "python-jose[cryptography]==3.3.0" \
    "passlib[bcrypt]==1.7.4" \
    httpx==0.25.2

# Install Development tools (optional but useful)
RUN pip3 install --no-cache-dir \
    pytest==7.4.3 \
    pytest-asyncio==0.21.1 \
    black==23.11.0 \
    flake8==6.1.0

# Create working directory
WORKDIR /workspace

# Create directories structure (สำหรับ workspace)
RUN mkdir -p /workspace

# Setup Hugging Face cache (ช่วยลด re-download ในแต่ละ Pod)
ENV HF_HOME=/workspace/.cache/huggingface
RUN mkdir -p $HF_HOME && chmod -R 777 /workspace

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_VISIBLE_DEVICES=0
# ป้องกัน freeze ของ CTranslate2/CUDA
ENV CT2_USE_CUDA_GRAPH=0
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4
# Default provider: faster-whisper (สามารถ override ได้)
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=medium
ENV WHISPER_DEVICE=auto
# เริ่มด้วย VAD=false (ผ่านแล้วค่อยเปิด true)
ENV WHISPER_VAD_FILTER=false
# Timezone
ENV TZ=Asia/Bangkok
ENV TZDIR=/usr/share/zoneinfo

# Expose ports (สำหรับ services ที่จะ start แบบ Direct mode)
EXPOSE 8001 8002 6379

# ⚠️ ไม่มี CMD - Image นี้เป็น complete base
# User ต้อง:
# 1. Clone repository: git clone <repo> /workspace/transcription-service
# 2. Start services: bash scripts/pod/start-services-direct.sh
#    หรือ bash scripts/pod/start-pod.sh
#
# ✅ ไม่ต้องรัน install-dependencies.sh อีกต่อไป!

# Default: Keep container running (wait for user to start services)
CMD ["/bin/bash", "-c", "echo '🚀 Complete Image Ready - All Dependencies Installed!'; echo '📋 Next steps:'; echo '   1. Clone repo: git clone <repo> /workspace/transcription-service'; echo '   2. Start services: bash scripts/pod/start-pod.sh'; echo '   ✅ No need to run install-dependencies.sh!'; echo ''; tail -f /dev/null"]

