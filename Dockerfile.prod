# ============================================================================
# Production Image (All-in-One): Self-Hosted Server
# รวม base + dependencies + code ใน Dockerfile เดียว
# เพื่อประหยัดพื้นที่ — ไม่ต้องเก็บ intermediate base image
#
# Server: 2x NVIDIA RTX PRO 4000 (24GB VRAM each), CPU 14, RAM 30GB
#
# Build on Mac:
#   docker buildx build --platform linux/amd64 \
#     -f Dockerfile.prod \
#     -t kksenateacr.azurecr.io/kk-transcription:release-v1.0.0 \
#     --load .
#
# Save:
#   docker save kksenateacr.azurecr.io/kk-transcription:release-v1.0.0 \
#     | gzip > docker-image/kk-transcription-release-v1.0.0.tar.gz
#
# Cleanup Mac (free disk):
#   docker rmi kksenateacr.azurecr.io/kk-transcription:release-v1.0.0
#   docker system prune -f
#
# Load on Server:
#   docker load -i kk-transcription-release-v1.0.0.tar.gz
#
# Layer caching (ถ้ายังไม่ prune):
#   - เปลี่ยนโค้ด       -> rebuild แค่ Layer 4   (วินาที)
#   - เปลี่ยน dependency -> rebuild Layer 3-4     (2-3 นาที)
#   - เปลี่ยน CUDA/torch -> rebuild ทั้งหมด      (นานสุด แต่นานๆ ครั้ง)
# ============================================================================

# ==========================================================================
# Stage 1: CUDA 12.8.1 + cuDNN 9 + Ubuntu 24.04
# ==========================================================================
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Bangkok

# ==========================================================================
# Layer 1: System tools + FFmpeg + Audio/File libraries
# ==========================================================================
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    git \
    wget \
    curl \
    ffmpeg \
    libsndfile1 \
    libsox-dev \
    sox \
    libmagic1 \
    build-essential \
    cmake \
    tzdata \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip && \
    python3 -m pip config set global.break-system-packages true

# ==========================================================================
# Layer 2: PyTorch 2.8.0 + torchaudio (CUDA 12.8)
# ==========================================================================
RUN pip install --no-cache-dir --timeout 600 --retries 3 \
    torch==2.8.0 \
    torchaudio==2.8.0 \
    --index-url https://download.pytorch.org/whl/cu128

# ==========================================================================
# Layer 2.5: ldconfig + environment variables
# ==========================================================================
RUN SITE_PKG=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib'))") && \
    echo "${SITE_PKG}/nvidia/cudnn/lib"  >  /etc/ld.so.conf.d/cudnn-cuda.conf && \
    echo "/usr/lib/x86_64-linux-gnu"     >> /etc/ld.so.conf.d/cudnn-cuda.conf && \
    echo "/usr/local/cuda-12.8/lib64"   >> /etc/ld.so.conf.d/cudnn-cuda.conf && \
    echo "/usr/local/cuda/lib64"         >> /etc/ld.so.conf.d/cudnn-cuda.conf && \
    ldconfig

RUN SITE_PKG=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib'))") && \
    echo "export LD_LIBRARY_PATH=${SITE_PKG}/nvidia/cudnn/lib:/usr/lib/x86_64-linux-gnu:/usr/local/cuda-12.8/lib64:/usr/local/cuda/lib64:\${LD_LIBRARY_PATH:-}" \
    > /etc/profile.d/cudnn-ctranslate2.sh

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:$PATH
ENV HF_HUB_ENABLE_HF_TRANSFER=0

# ==========================================================================
# Layer 3: Python dependencies (rebuild เฉพาะเมื่อ requirements เปลี่ยน)
# ==========================================================================
COPY requirements.runpod-unified.txt /tmp/
RUN pip install --no-cache-dir --timeout 600 --retries 3 -r /tmp/requirements.runpod-unified.txt && \
    rm /tmp/requirements.runpod-unified.txt

# Verify packages installed (ไม่ต้องใช้ GPU — ตรวจแค่ import ได้)
# CUDA verification จะทำตอน runtime โดย start-pod.sh / start-rq-workers.sh
RUN python3 -c "\
import ctranslate2; print(f'ctranslate2 {ctranslate2.__version__}'); \
from faster_whisper import WhisperModel; print('faster-whisper OK'); \
import torch; print(f'torch {torch.__version__}'); \
"

# ==========================================================================
# Layer 4: Application code (rebuild ทุกครั้งที่โค้ดเปลี่ยน — เร็วมาก)
# ==========================================================================
COPY . /workspace/transcription-service
WORKDIR /workspace/transcription-service

RUN chmod +x scripts/pod/*.sh scripts/utility/*.sh 2>/dev/null || true

# ==========================================================================
# Ports: 8010 (Main API), 8002 (Whisper API)
# ==========================================================================
EXPOSE 8010 8002

# ==========================================================================
# Start: start-pod.sh → verify CUDA + start services
#        start-rq-workers.sh → start GPU/CPU workers
#        tail -f → keep container alive (services run as background processes)
# ==========================================================================
CMD ["bash", "-c", "./scripts/pod/start-pod.sh && ./scripts/pod/start-rq-workers.sh && tail -f /dev/null"]
