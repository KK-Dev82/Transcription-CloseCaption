[Unit]
Description=Transcription Service Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/workspace/transcription-service/dashboard
Environment="PYTHONPATH=/workspace/transcription-service"
Environment="DASHBOARD_PORT=8020"

# Load environment from .env.runpod if exists
EnvironmentFile=/workspace/transcription-service/.env.runpod

# Activate virtual environment and run
ExecStart=/bin/bash -c 'source /workspace/transcription-service/dashboard/venv/bin/activate && python3 -m uvicorn main:app --host 0.0.0.0 --port 8020'

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=transcription-dashboard

[Install]
WantedBy=multi-user.target
