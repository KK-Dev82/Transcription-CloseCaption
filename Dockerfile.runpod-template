# Minimal Base Image สำหรับ RunPod (ใช้ RunPod Template)
# มีแค่ CUDA + Dependencies พื้นฐาน (ไม่ start services อัตโนมัติ)
#
# ⚠️ หมายเหตุ:
# - Image นี้เป็น minimal base - ไม่มี services start อัตโนมัติ
# - User ต้อง clone repo และ run scripts/pod/start-services-direct.sh เอง
#
# ✅ ข้อดีของการใช้ RunPod Template:
# - Build เร็ว (~5-10 นาที เทียบกับ ~20-30 นาที)
# - มี PyTorch + CUDA พร้อมแล้ว ไม่ต้องติดตั้งเพิ่ม
# - Optimized สำหรับ RunPod environment
# - ขนาด image เล็กกว่า (ไม่ต้องติดตั้ง CUDA toolkit เต็ม)
#
# Build for linux/amd64 (RunPod)
# Note: Use --platform=linux/amd64 when building on ARM64 (MacOS M1/M2)
FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

# Install system dependencies
# PyTorch และ CUDA มีอยู่แล้วใน base image
RUN apt-get update && apt-get install -y \
    # Build tools (บางส่วนอาจมีอยู่แล้ว)
    build-essential \
    cmake \
    git \
    git-lfs \
    wget \
    curl \
    # Redis (สำหรับ local Redis service ใน Direct mode)
    redis-server \
    # Utilities
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio/Video processing
    ffmpeg \
    # Network tools
    netcat \
    telnet \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Initialize git-lfs (สำหรับโมเดล/ไฟล์ใหญ่ใน Git)
RUN git lfs install

# ตรวจสอบ PyTorch (ควรมีอยู่แล้ว - optional check)
# RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.version.cuda}')"

# Upgrade PyTorch เป็น 2.1.1 (ถ้าต้องการ)
# หรือใช้ 2.1.0 ที่มีอยู่แล้วก็ได้
RUN pip3 install --no-cache-dir --upgrade \
    torch==2.1.1 \
    torchaudio==2.1.1 \
    --index-url https://download.pytorch.org/whl/cu118

# Install faster-whisper with compatible versions (CUDA 11.8)
# ตามคำแนะนำ: ctranslate2==4.5.0, faster-whisper==1.0.2, numpy==1.26.4
RUN pip3 install --no-cache-dir \
    numpy==1.26.4 \
    "ctranslate2==4.5.0" \
    "faster-whisper==1.0.2"

# Install Python dependencies (พื้นฐาน)
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    requests \
    aiohttp \
    aiofiles \
    redis \
    pika \
    python-dotenv \
    tzdata \
    ffmpeg-python

# Create working directory
WORKDIR /workspace

# Create directories structure (สำหรับ workspace)
RUN mkdir -p /workspace

# Setup Hugging Face cache (ช่วยลด re-download ในแต่ละ Pod)
ENV HF_HOME=/workspace/.cache/huggingface
RUN mkdir -p $HF_HOME && chmod -R 777 /workspace

# ⚠️ ไม่ copy setup scripts - ให้ user clone repo และ run scripts เอง
# ⚠️ ไม่มี CMD - ให้ user start services แบบ Direct mode เอง

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_VISIBLE_DEVICES=0
# ป้องกัน freeze ของ CTranslate2/CUDA
ENV CT2_USE_CUDA_GRAPH=0
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4
# Default provider: faster-whisper (สามารถ override ได้)
ENV WHISPER_PROVIDER=faster-whisper
ENV WHISPER_MODEL=medium
ENV WHISPER_DEVICE=auto
# เริ่มด้วย VAD=false (ผ่านแล้วค่อยเปิด true)
ENV WHISPER_VAD_FILTER=false

# Expose ports (สำหรับ services ที่จะ start แบบ Direct mode)
EXPOSE 8001 8002 6379

# ⚠️ ไม่มี CMD - Image นี้เป็น minimal base
# User ต้อง:
# 1. Clone repository: git clone <repo> /workspace/transcription-service
# 2. Start services: bash scripts/pod/start-services-direct.sh
# หรือ
# 3. Use restart script: bash scripts/pod/restart-pod-services.sh

# Default: Keep container running (wait for user to start services)
CMD ["/bin/bash", "-c", "echo '🚀 RunPod Base Image Ready'; echo '📋 Next steps:'; echo '   1. Clone repo: git clone <repo> /workspace/transcription-service'; echo '   2. Start services: bash scripts/pod/restart-pod-services.sh'; echo ''; tail -f /dev/null"]

